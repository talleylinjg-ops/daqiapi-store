# Copy this file to .env and fill in your values.
# Backend port
PORT=3001

# Path to the One API SQLite database file
ONE_API_DB=/opt/one-api/one-api.db

# Quota units per 1 USD (One API default is 500000)
QUOTA_PER_UNIT=500000

# --- Stripe (real payments) ---
# Leave STRIPE_SECRET_KEY empty to run in DEMO mode (no real payment).
# When you have real keys, set both of these and restart.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: absolute base URL used for Stripe return URLs.
# If empty, the backend derives it from the request host automatically.
# APP_BASE_URL=https://your-domain.com

# --- eSIM upstream suppliers (multi-supplier price comparison) ---
# Comma separated list of providers. The engine auto-fetches wholesale prices
# from every configured provider and picks the CHEAPEST one per plan.
# Leave ESIM_PROVIDER empty to use the built-in DEMO providers (simulated prices).
# ESIM_PROVIDER=airalo,esimgo
#
# Retail margin applied on top of the best wholesale price (default 0.18 = 18%)
# ESIM_MARGIN=0.18
#
# Provider 1: Airalo Partner API
# ESIM_AIRALO_CLIENT_ID=
# ESIM_AIRALO_CLIENT_SECRET=
# ESIM_AIRALO_BASE_URL=https://partner.airalo.com
# Map each plan to an Airalo package: ESIM_AIRALO_PLAN_<PLANKEY>=<package_id>
#   e.g. ESIM_AIRALO_PLAN_GLOBAL_10GB=995
#
# Provider 2: eSIMGo Partner API
# ESIMGO_API_KEY=
# ESIMGO_API_URL=https://partner.esimgo.com
# Map each plan to an eSIMGo SKU: ESIM_ESIMGO_PLAN_<PLANKEY>=<sku>
#   e.g. ESIM_ESIMGO_PLAN_GLOBAL_10GB=esim-go-global-10gb

# --- VPN (self-hosted on Oracle Cloud Always Free) ---
# VPN_PROVIDER=oracle  -> deploy WireGuard to your free-tier US instance over SSH
# Leave VPN_PROVIDER empty to use the DEMO provider (generates a local client config).
# VPN_PROVIDER=oracle
# VPN_ORACLE_HOST=140.xxx.xxx.xxx
# VPN_ORACLE_USER=opc
# VPN_ORACLE_PORT=22
# VPN_ORACLE_KEY_FILE=/path/to/ssh_private_key
# VPN_ORACLE_PUBLIC_IP=140.xxx.xxx.xxx
